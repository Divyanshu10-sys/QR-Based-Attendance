# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/qr_attendance?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# QR / Session
QR_TOKEN_TTL_SECONDS=25
SESSION_MAX_DURATION_MINUTES=60

# Geofencing default (can be overridden per-session by admin/teacher)
DEFAULT_ALLOWED_RADIUS_METERS=60

# Face verification
FACE_MATCH_THRESHOLD=0.45

# CORS
FRONTEND_ORIGIN=http://localhost:5500

# Admin bootstrap (used only by seedAdmin.js, run once then remove)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!
